rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── helpers ────────────────────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }

    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isAuth() && userRole() == 'admin';
    }

    function isDriver() {
      return isAuth() && userRole() == 'driver';
    }

    function hasClientAccess(clientId) {
      return isAuth() && exists(
        /databases/$(database)/documents/clientAccess/$(request.auth.uid + '_' + clientId)
      );
    }

    function getClientAccess(clientId) {
      return get(
        /databases/$(database)/documents/clientAccess/$(request.auth.uid + '_' + clientId)
      ).data;
    }

    // ── public intake (Apply form) ─────────────────────────────────────────
    // Unauthenticated parents can submit an application; they write to
    // clients / students / bookings directly. Reads and mutations require auth.
    // Creates are size-limited to prevent abuse (max 20 KB payload).

    match /clients/{id} {
      allow create: if request.resource.data.keys().hasAll(['name', 'email', 'phone'])
                    && request.resource.data.name is string
                    && request.resource.data.email is string
                    && request.resource.size() < 20480;
      allow read:   if isAuth();
      allow update: if isAdmin()
                    || (isAuth() && resource.data.uid == request.auth.uid)
                    || (hasClientAccess(id) && getClientAccess(id).permissions.canEdit == true);
      allow delete: if isAdmin();
    }

    match /students/{id} {
      allow create: if request.resource.data.keys().hasAll(['name', 'clientId'])
                    && request.resource.data.name is string
                    && request.resource.size() < 20480;
      allow read, update, delete: if isAuth();
    }

    match /bookings/{id} {
      allow create: if request.resource.data.keys().hasAll(['clientId'])
                    && request.resource.data.clientId is string
                    && request.resource.size() < 20480;
      allow read, update, delete: if isAuth();
    }

    // ── driver / route data ─────────────────────────────────────────────────
    // Admins manage drivers and route assignments.
    // Drivers can read their own assignments and write route logs.

    match /drivers/{id} {
      allow read:  if isAuth();           // parents + drivers need to see driver names/phones
      allow create, delete: if isAdmin();
      // Admins can update anything; a driver may update their own doc (photoURL, phone)
      allow update: if isAdmin()
                    || (isDriver() && resource.data.uid == request.auth.uid);

      // Driver onboarding subcollection — admins full access; a driver can
      // read/write their own onboarding docs (where parent driver doc
      // has uid == request.auth.uid).
      match /onboarding/{docId} {
        allow read, write: if isAdmin()
                           || (isDriver()
                               && get(/databases/$(database)/documents/drivers/$(id)).data.uid
                                  == request.auth.uid);
      }
    }

    match /routeAssignments/{id} {
      allow read:  if isAuth();
      allow write: if isAdmin();
    }

    match /routeLogs/{id} {
      allow read:  if isAuth();
      allow write: if isDriver() || isAdmin();   // only drivers + admins can log runs
    }

    // ── admin-only collections ──────────────────────────────────────────────

    match /contracts/{id} {
      allow read, write: if isAdmin();
    }

    match /emailQueue/{id} {
      allow read, write: if isAdmin();
    }

    // ── audit log ────────────────────────────────────────────────────────────
    // Written exclusively by Cloud Functions (server-side) via the Admin SDK,
    // which bypasses Security Rules entirely — no client write needed.
    // Admins can read for investigation; no client writes allowed.

    match /auditLog/{id} {
      allow read:  if isAdmin();
      allow write: if false;   // Admin SDK only
    }

    // ── user profiles ────────────────────────────────────────────────────────
    // Users can read their own profile (to get role/linkedId).
    // Admins can read and write all user docs.

    match /users/{userId} {
      allow read:   if isAuth() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuth();
      allow update: if isAdmin() || request.auth.uid == userId;
      allow delete: if isAdmin();
    }

    // ── clientAccess ───────────────────────────────────────
    // Doc id format: {uid}_{clientId}
    // Admins manage all. A user can read their own doc.
    // The invite-acceptance write path (uid was null, now set) is handled by
    // a Cloud Function (Admin SDK) — no direct client write on acceptance.

    match /clientAccess/{docId} {
      allow read:   if isAdmin() || (isAuth() && resource.data.uid == request.auth.uid);
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── driver live location ─────────────────────────────────────────────────
    // Drivers write their own location doc (doc id = their driverId / linkedId).
    // All authenticated users (parents, admins) can read for live tracking.

    match /driverLocations/{driverId} {
      allow read:  if isAuth();
      allow write: if isDriver() || isAdmin();   // only drivers + admins
    }

    // ── in-app notifications ──────────────────────────────────────────────────
    match /notifications/{id} {
      allow read:   if isAuth() && resource.data.recipientUid == request.auth.uid;
      allow create: if isAuth();
      allow update: if isAuth() && resource.data.recipientUid == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);
      allow delete: if isAdmin();
    }
    // Parents can read their own invoices (matched via clientId == their linkedId).
    // Admins have full access. Writes are done by Cloud Functions (Admin SDK).

    match /invoices/{id} {
      allow read:  if isAdmin()
                   || (isAuth() && resource.data.clientId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.linkedId)
                   || (isAuth() && hasClientAccess(resource.data.clientId)
                       && getClientAccess(resource.data.clientId).permissions.canSeeInvoices == true);
      allow write: if isAdmin();
    }

    // ── background tasks (admin → Cloud Function via Firestore trigger) ──────
    // Admins create task docs; Cloud Functions (Admin SDK) update them with
    // results.  Clients can read to poll for completion.

    match /_tasks/{id} {
      allow create: if isAdmin();
      allow read:   if isAdmin();
      allow update, delete: if false;   // Cloud Functions only (Admin SDK)
    }

    // ── driver shifts ─────────────────────────────────────────────────────────
    match /driverShifts/{id} {
      allow read:  if isAdmin() || (isDriver() && resource.data.driverId ==
                     get(/databases/$(database)/documents/users/$(request.auth.uid)).data.linkedId);
      allow create, update: if isAdmin() || (isDriver() && request.resource.data.driverId ==
                               get(/databases/$(database)/documents/users/$(request.auth.uid)).data.linkedId);
      allow delete: if isAdmin();
    }

    // ── driver breaks ─────────────────────────────────────────────────────────
    match /driverBreaks/{id} {
      allow read:  if isAdmin() || (isDriver() && resource.data.driverId ==
                     get(/databases/$(database)/documents/users/$(request.auth.uid)).data.linkedId);
      allow create, update: if isAdmin() || (isDriver() && request.resource.data.driverId ==
                               get(/databases/$(database)/documents/users/$(request.auth.uid)).data.linkedId);
      allow delete: if isAdmin();
    }

    // ── incidents ─────────────────────────────────────────────────────────────
    match /incidents/{id} {
      allow read:  if isAdmin() || (isAuth() && resource.data.reportedByUid == request.auth.uid);
      allow create: if isAuth();
      allow update, delete: if isAdmin();
    }

    // ── client communications log ──────────────────────────────────────────────
    match /clientCommunications/{id} {
      allow read: if isAdmin()
                  || (isAuth() && hasClientAccess(resource.data.clientId))
                  || (isAuth() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.linkedId == resource.data.clientId);
      allow create, update, delete: if isAdmin();
    }

    // ── Stripe webhook idempotency (server only via Admin SDK) ─────────────────
    match /processedStripeEvents/{id} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    // ── apply rate limits (server only) ───────────────────────────────────────
    match /applyRateLimits/{id} {
      allow read, write: if false;   // Cloud Functions Admin SDK only
    }

    // ── driver payouts (server only) ──────────────────────────────────────────
    match /driverPayouts/{id} {
      allow read: if isAdmin() || (isDriver() && resource.data.driverId ==
                  get(/databases/$(database)/documents/users/$(request.auth.uid)).data.linkedId);
      allow write: if false;   // Cloud Functions only
    }

  }
}

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_GOOGLE_MAPS_API_KEY=

# Copy this file to .env and fill in real values. Never commit your .env with secrets.
# Google Maps API key referrer recommendations (for Restrictions -> HTTP referrers):
# - Local Vite dev (adjust port if different): http://localhost:5173/*
# - Local alternate dev port example: http://localhost:5200/*
# - Production (Vercel): https://your-app.vercel.app/*
# When restricting APIs for this key, limit to Distance Matrix API, Geocoding API, and Maps JavaScript API (or Places API) only.

# For production, DO NOT expose a key in client bundles. Use a server-side proxy (Cloud Function) and store GOOGLE_MAPS_API_KEY in secure server env.